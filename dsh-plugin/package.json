{
  "name": "@local/dsh-sci-figure",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Optional DSH panel for sci-figure-kit: model-facing backend tools plus a figure/mod panel with per-mod enable switches.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
